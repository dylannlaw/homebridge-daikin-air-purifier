{
  "displayName": "Homebridge Daikin Air Purifier",
  "name": "@dylannlaw/homebridge-daikin-air-purifier",
  "type": "module",
  "version": "1.0.6",
  "description": "Homebridge plugin for Daikin Air Purifier",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dylannlaw/homebridge-daikin-air-purifier.git"
  },
  "bugs": {
    "url": "https://github.com/dylannlaw/homebridge-daikin-air-purifier/issues"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test": "npm run build && node --test 'test/*.test.mjs'",
    "test:coverage": "npm run build && node -e \"fs.mkdirSync('coverage',{recursive:true})\" && node --enable-source-maps --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"dist/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.test.mjs\"",
    "homebridge:local": "bash scripts/local-homebridge.sh",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "daikin",
    "air purifier",
    "humidifier",
    "MCK70W"
  ],
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
